# Copy this file to .env and fill in the value locally.
# Never commit .env or paste the token into Markdown, JSONL, or chat.

# X API v2 app-only authentication for public data.
# Create/copy this from the X Developer Console's Keys and tokens page.
X_BEARER_TOKEN=

# Optional client settings used by future X API collectors.
X_API_BASE_URL=https://api.x.com
X_API_TIMEOUT_SECONDS=30
