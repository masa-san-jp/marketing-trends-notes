{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_id",
    "contract_version",
    "creator_id",
    "document",
    "epistemic_status",
    "lifecycle",
    "observed_at",
    "origin_instance_id",
    "record_id",
    "reference_documents",
    "revision",
    "source_checks",
    "supersedes"
  ],
  "properties": {
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "string",
      "minLength": 1
    },
    "source_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "retrieved",
          "checked_at",
          "content_sha256",
          "geo",
          "channels"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "retrieved": {
            "enum": [
              "primary",
              "summary"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "geo": {
            "type": "string"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contract_version": {
      "const": "market-observation/v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reference_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_status": {
      "enum": [
        "observed",
        "externally-supported",
        "inferred",
        "proposed",
        "simulated",
        "unknown"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "lifecycle": {
      "enum": [
        "accepted",
        "revoked"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
